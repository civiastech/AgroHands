# Copy to .env and fill in. Never commit .env.
# Local dev needs none of this; production needs at least DOMAIN, BASE_URL and SESSION_SECRET.

# --- Core -----------------------------------------------------------------------------------------
NODE_ENV=production
# Public URL (https:// required in production).
BASE_URL=https://agrohands.example
# Domain Caddy serves and gets a certificate for (Docker production only). Point its DNS A record at the server first.
DOMAIN=agrohands.example
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# NEVER change it after launch: it signs sessions AND keys the NIN hashes.
SESSION_SECRET=
# Comma-separated phones that become admin when they register.
ADMIN_PHONES=08030000001

# --- Network ----------------------------------------------------------------------------------------
PORT=3000
# true when behind Caddy/nginx/a load balancer (Docker images default to true). false when exposed directly.
TRUST_PROXY=true

# --- Storage (host installs; Docker sets these itself) ---------------------------------------------------
# DB_PATH=./data/agrohands.db
# BACKUP_DIR=./backups
BACKUP_KEEP_DAYS=14

# --- Integrations ---------------------------------------------------------------------------------------
# manual (free, agent checks NIN slip) | dojah (paid API) | mock (tests only — rejected in production)
NIN_PROVIDER=manual
DOJAH_APP_ID=
DOJAH_SECRET_KEY=
# Africa's Talking must call /ussd?key=<this>. In production /ussd is disabled until this is set.
USSD_KEY=
# SMS: sign-up codes (phone ownership), PIN reset codes, and offer/contract alerts.
# Production needs africastalking; it refuses to start with "log" because nobody could receive a code.
# Africa's Talking dashboard → Settings → API Key. Test with AT_USERNAME=sandbox and a sandbox key first.
SMS_PROVIDER=africastalking
AT_USERNAME=
AT_API_KEY=
# Registered sender id (max 11 characters). Without one, messages to DND numbers may be dropped.
SMS_SENDER_ID=AgroHands
# Cost guards: at most this many SMS per 24 hours (admins are alerted when reached), and one-time codes per IP per hour.
SMS_DAILY_LIMIT=1000
OTP_PER_IP_HOUR=30
# --- Payments (Paystack) ----------------------------------------------------------------------------------
# Paid courses on the website. Empty = paid courses are free (pilot). Start with sk_test_… then switch to sk_live_….
# Webhook URL to set in Paystack (Settings → API Keys & Webhooks): https://YOUR-DOMAIN/pay/webhook
PAYSTACK_SECRET_KEY=
# --- Off-site backups and alerts ----------------------------------------------------------------------------
# Any S3-compatible bucket: Cloudflare R2 (https://<account-id>.r2.cloudflarestorage.com, region auto),
# Backblaze B2 (https://s3.<region>.backblazeb2.com), AWS S3 (https://s3.<region>.amazonaws.com).
# Give the key write access to this one bucket only, and add a lifecycle rule that deletes objects after 90 days.
BACKUP_S3_ENDPOINT=
BACKUP_S3_REGION=auto
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
# Required with a bucket. Generate with: openssl rand -hex 32. Store it in your password manager:
# without it the off-site backups cannot be restored.
BACKUP_ENCRYPTION_KEY=
# Dead-man's switch: a Healthchecks.io / Better Stack heartbeat URL, pinged after every backup.
BACKUP_HEARTBEAT_URL=
# Slack or Discord incoming-webhook URL: errors are posted here (throttled).
ALERT_WEBHOOK_URL=
SUPPORT_WHATSAPP=
# Shown on /privacy and /account-deletion. Google Play requires a contact.
SUPPORT_EMAIL=

# --- Google Play app (see docs/PLAY_STORE.md) -------------------------------------------------------
# Reverse-domain id, permanent once published.
ANDROID_PACKAGE=ng.agrohands.app
# SHA-256 fingerprints of your upload key AND Play's app-signing key (Play Console → App integrity), comma-separated.
# Served at /.well-known/assetlinks.json so the app opens full-screen with no browser bar.
ANDROID_CERT_SHA256=
# Optional: must go up by 1+ for every Play upload. Default derives from package.json version (1.2.3 → 10203).
# ANDROID_VERSION_CODE=

# --- Operations -------------------------------------------------------------------------------------------
# debug | info | warn | error
LOG_LEVEL=info
# json | pretty
LOG_FORMAT=json
# Bearer token for GET /metrics (Prometheus). Empty = disabled. Caddy blocks /metrics from the internet regardless.
METRICS_TOKEN=
# Requests per IP per window: auth (login/register/PIN/NIN) and all form posts.
RATE_LIMIT_AUTH_MAX=20
RATE_LIMIT_WRITE_MAX=120
RATE_LIMIT_WINDOW_SEC=300
